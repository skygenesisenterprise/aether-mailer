  permissions MailGroupPermission[]

  @@index([tenantId])
  @@map("mail_groups")
}

model MailGroupMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  accountId String   @map("account_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group MailGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("mail_group_members")
}

model MailGroupPermission {
  id         String   @id @default(uuid())
  groupId    String   @map("group_id")
  permission String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group MailGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("mail_group_permissions")
}

// ═══════════════════════════════════════════════════════
// Mail — Roles & Permissions
// ═══════════════════════════════════════════════════════

model MailRole {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String   @default("")
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  MailTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members MailRoleMember[]

  @@index([tenantId])
  @@map("mail_roles")
}

model MailRoleMember {
  id          String   @id @default(uuid())
  roleId      String   @map("role_id")
  principalId String   @map("principal_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  role MailRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("mail_role_members")
}

// ═══════════════════════════════════════════════════════
// Mail — Mailing Lists
// ═══════════════════════════════════════════════════════

model MailingList {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  email          String
  isEnabled      Boolean  @default(true) @map("is_enabled")
  moderationMode String   @default("none") @map("moderation_mode")
  description    String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant      MailTenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscribers MailingListSubscriber[]
  moderation  MailingListModeration?

  @@index([tenantId])
  @@map("mailing_lists")
}

model MailingListSubscriber {
  id        String   @id @default(uuid())
  listId    String   @map("list_id")
  email     String
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  list MailingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("mailing_list_subscribers")
}

model MailingListModeration {
  id              String   @id @default(uuid())
  listId          String   @unique @map("list_id")
  moderatorEmails Json     @default("[]") @map("moderator_emails")
  postingMode     String   @default("members_only") @map("posting_mode")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  list MailingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("mailing_list_moderations")
}

// ═══════════════════════════════════════════════════════
// Mail — SMTP Routes & Queue
// ═══════════════════════════════════════════════════════

model SmtpRoute {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  name       String
  remoteHost String   @map("remote_host")
  port       Int      @default(25)
  requireTls Boolean  @default(true) @map("require_tls")
  username   String   @default("")
  password   String   @default("")
  maxRetries Int      @default(3) @map("max_retries")
  priority   Int      @default(0)
  isEnabled  Boolean  @default(true) @map("is_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("smtp_routes")
}

model SmtpQueueEntry {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  from       String    @map("from_addr")
  to         String    @map("to_addr")
  size       BigInt    @default(0)
  retries    Int       @default(0)
  maxRetries Int       @default(5) @map("max_retries")
  status     String    @default("queued")
  nextRetry  DateTime? @map("next_retry")
  error      String    @default("")
  routeId    String    @default("") @map("route_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("smtp_queue")
}

// ═══════════════════════════════════════════════════════
// Mail — Certificates
// ═══════════════════════════════════════════════════════

model Certificate {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  domain      String
  certPem     String   @map("cert_pem")
  keyPem      String   @map("key_pem")
  issuer      String   @default("")
  expiresAt   DateTime @map("expires_at")
  isAutoRenew Boolean  @default(false) @map("is_auto_renew")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([domain])
  @@map("certificates")
}

// ═══════════════════════════════════════════════════════
// Mail — Logs & Reports
// ═══════════════════════════════════════════════════════

model LogEntry {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  level     String
  category  String
  message   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant MailTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([category])
  @@index([level])
  @@index([createdAt])
  @@map("log_entries")
}

model ReportRecord {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  domain    String
  type      String
  reporter  String
  period    DateTime
  summary   Json     @default("{}")
  rawData   Bytes    @default("") @map("raw_data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([domain])
  @@map("report_records")
}

// ═══════════════════════════════════════════════════════
// Mail — Metrics
// ═══════════════════════════════════════════════════════

model ServerMetrics {
  id          String   @id @default(uuid())
  timestamp   DateTime
  imapActive  Int      @default(0) @map("imap_active")
  jmapActive  Int      @default(0) @map("jmap_active")
  smtpActive  Int      @default(0) @map("smtp_active")
  queueSize   Int      @default(0) @map("queue_size")
  storageUsed BigInt   @default(0) @map("storage_used")
  cpuUsage    Float    @default(0) @map("cpu_usage")
  memoryUsage Float    @default(0) @map("memory_usage")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([timestamp])
  @@map("server_metrics")
}

// ═══════════════════════════════════════════════════════
// Mail — API Keys
// ═══════════════════════════════════════════════════════

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique @map("key_hash")
  prefix     String
  tenantId   String    @map("tenant_id")
  scopes     Json      @default("[]")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ═══════════════════════════════════════════════════════
