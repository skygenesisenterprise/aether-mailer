# Notploy — self-hosted / cloud configuration.
#
#   cp .env.example .env
#
# Replace every placeholder before exposing the instance. The defaults in
# docker-compose.yml only exist so `docker compose config` works out of the box;
# they are NOT safe for production.

# --- Image / product -----------------------------------------------------
# NOTPLOY_FLAVOR selects the mode and the Dockerfile target: `selfhosted`
# (default), `cloud` or `console`. The Makefile derives NOTPLOY_IMAGE and
# IS_CLOUD from it; override the image for a mirror, or drive `docker compose`
# directly. `make docker-up -- --self|--cloud|--console` sets all of them for a
# single invocation.
NOTPLOY_FLAVOR=selfhosted
NOTPLOY_IMAGE=ghcr.io/skygenesisenterprise/notploy
NOTPLOY_VERSION=latest
# IS_CLOUD=true switches the app to cloud behaviour (managed queue, billing...).
# It is set automatically for cloud and console; keep it in sync if you set the
# flavor by hand.
IS_CLOUD=false
# Explicit product override (self | cloud | console). Leave empty to derive it
# from NOTPLOY_FLAVOR / IS_CLOUD. Cloud and console require a signed entitlement.
NOTPLOY_PRODUCT=

# --- Networking ----------------------------------------------------------
# Host port of the dashboard. Production (`make docker-up`) and development
# (`make docker-dev`) both publish it, so the app is always reachable at
# http://localhost:3000 whichever mode you run (only one mode at a time).
NOTPLOY_PORT=3000

# Host port the Notploy DNS server is published on in production (the container
# always listens on 53). It must be free on the host: systemd-resolved
# (127.0.0.53), dnsmasq or Pi-hole take 53 on most distros and the container
# then fails to start with "listen tcp4 0.0.0.0:53: bind: address already in
# use". Check with `ss -lntu | grep :53` and pick a free port if needed.
NOTPLOY_DNS_HOST_PORT=53

# Same, for the development stack (`make docker-dev`): it defaults to 5300 so
# the dev server starts on a machine where something already holds 53. Query it
# with `dig @127.0.0.1 -p 5300`.
NOTPLOY_DNS_DEV_HOST_PORT=5300

# --- Database ------------------------------------------------------------
POSTGRES_USER=notploy
POSTGRES_DB=notploy
# CHANGE ME — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password
# Internal control-plane URL, consumed by the app containers and pointed at the
# Compose-managed `redis` service (not reviewed on the host). Override only to
# point at an external Redis.
REDIS_URL=redis://redis:6379

# --- Authentication ------------------------------------------------------
# CHANGE ME — session signing secret, generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-better-auth-secret

# --- Misc ----------------------------------------------------------------
TZ=UTC
