DATABASE_URL="postgres://notploy:amukds4wi9001583845717ad2@localhost:5432/notploy"
PORT=3000
NODE_ENV=development

# Templates are read from ../templates/blueprints when that directory exists
# (auto-detected by walking up from the working directory), so local dev never
# depends on https://templates.notploy.com. Set this only to force another path.
# NOTPLOY_TEMPLATES_DIR=/absolute/path/to/templates/blueprints

# Ghost Content API, used by the console Website > Blog page. Point these at the
# same Ghost site that powers web/apps/website.
# GHOST_URL=https://status.notploy.com
# GHOST_KEY=42424242424242424242424242424242
# Ghost Admin API key (<id>:<secret>), required to publish posts from the console.
# GHOST_ADMIN_KEY=0123456789abcdef0123456789:0123456789abcdef0123456789abcdef

# --- Traffic Manager (Dashboard > Website > Traffic) --------------------------
# HTTP observability reads the Traefik access log incrementally; audience
# analytics is fed by the web instrumentation script served at /traffic.js.
# Only needed when the defaults do not fit the instance.
# TRAFFIC_TRAEFIK_LOG_PATH=/etc/notploy/traefik/dynamic/access.log
# TRAFFIC_COLLECTOR_CRON="*/5 * * * *"
# TRAFFIC_RETENTION_CRON="20 3 * * *"
# TRAFFIC_HTTP_RETENTION_DAYS=30
# TRAFFIC_AUDIENCE_RETENTION_DAYS=90
# TRAFFIC_MAX_EVENTS_PER_RUN=20000
# TRAFFIC_MAX_LOG_BYTES_PER_RUN=5000000
# TRAFFIC_SOURCE_STALE_MINUTES=60
# Set to false to refuse every audience event (kill switch).
# TRAFFIC_AUDIENCE_INGEST=true

# Notploy Status instance driven by the console Dashboard > Incidents page.
# STATUS_URL is the public origin of the status app (apps/status, port 4100
# in dev). STATUS_TOKEN is an administration token created from the status
# admin CLI (`pnpm --filter @notploy/status token:create`) or API; it needs
# the read, write and publish scopes so the console can list, draft, update
# and publish incidents and maintenances.
# STATUS_URL=http://localhost:4100
# STATUS_TOKEN=nps_...
