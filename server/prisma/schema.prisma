  tenantId    String   @map("tenant_id")
  principal   String
  permission  String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("acl_entries")
}

model DnsblServer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  hostname  String
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant MailTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dnsbl_servers")
}

// ═══════════════════════════════════════════════════════
// Mail — Policies & System Sieve
// ═══════════════════════════════════════════════════════

model PolicyRule {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
