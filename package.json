{
	"name": "mailer",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter=@mailer/app run dev",
		"start": "pnpm --filter=@mailer/app run start",
		"setup": "pnpm --filter=@mailer/app run setup",
		"build": "pnpm -r run build",
		"build:app": "pnpm --filter=@mailer/app run build",
		"test": "pnpm --filter=@mailer/app run test",
		"typecheck": "pnpm -r run typecheck",
		"server:script": "pnpm --filter=@mailer/server run switch:dev",
		"server:dev": "pnpm --filter=@mailer/server run dev",
		"server:build": "pnpm --filter=@mailer/server run build",
		"docker:build:canary": "./apps/mailer/docker/build.sh canary",
		"lint": "biome check .",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "pnpm --filter=@mailer/app run generate:openapi",
		"changeset": "changeset",
		"changeset:add": "changeset add",
		"changeset:status": "changeset status",
		"changeset:version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^2.29.7",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@tryghost/content-api": "^1.12.12",
		"@types/node": "^24.4.0",
		"@types/tryghost__content-api": "^1.3.17",
		"dotenv": "16.4.5",
		"esbuild": "0.28.2",
		"lint-staged": "^15.5.2",
		"tsx": "4.22.4"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=9.12.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"dependencies": {
		"@skygenesisenterprise/react-sds": "^1.0.0",
		"ldapts": "^9.2.0",
		"node-forge": "^1.4.0"
	}
}
